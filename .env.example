# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Real LLM Stack Generation (Set in Supabase Edge Functions Secrets or here for local dev)
OPENAI_API_KEY=sk-proj-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Optional: GitHub Proxy Token for higher rate limits (5,000 req/hr)
GITHUB_TOKEN=ghp_your-github-token

# Optional: Webhook Secret for repo synchronization
WEBHOOK_SECRET=your-secure-webhook-secret

# Optional: Telemetry & Monitoring
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
