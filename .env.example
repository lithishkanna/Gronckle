# Supabase Configuration (Required for app to connect to backend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (Optional: for local migration scripts, seed/enrich scripts, or admin tasks)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Providers (Optional: set in Supabase Edge Function secrets or local dev for AI recommendations & embeddings)
# OPENAI_API_KEY=sk-proj-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# GitHub Token (Optional: used by github-proxy and tool auto-enrichment to avoid rate limits)
# GITHUB_TOKEN=ghp_your-github-token

# Upstash Redis (Optional: used by github-proxy edge function for caching repo metadata)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Webhook Secret (Optional: protects the webhook-sync edge function endpoint)
# WEBHOOK_SECRET=your-secure-webhook-secret

# Telemetry & Monitoring (Optional)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_SENTRY_DSN=
